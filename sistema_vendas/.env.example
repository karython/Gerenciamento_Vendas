# ============================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DE VENDAS
# ============================================
# Copie este arquivo para .env e preenchha com seus dados

# ============================================
# SEGURANÇA
# ============================================
SECRET_KEY=sua-chave-secreta-super-longa-e-aleatoria-aqui
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com

# ============================================
# BANCO DE DADOS (MySQL)
# ============================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=sistema_vendas
DB_USER=root
DB_PASSWORD=sua-senha-forte
DB_HOST=localhost
DB_PORT=3306

# ============================================
# TIMEZONE
# ============================================
TIME_ZONE=America/Sao_Paulo

# ============================================
# CONFIGURAÇÃO DE SESSÃO - OTIMIZADO PARA PRODUÇÃO
# ============================================
# IMPORTANTE: Em produção, deixar FALSE para reduzir queries ao banco
# Sessão será salva apenas quando houver mudanças
SESSION_SAVE_EVERY_REQUEST=False
SESSION_COOKIE_AGE=3600

# ============================================
# SEGURANÇA HTTPS (ATIVAR EM PRODUÇÃO)
# ============================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# CACHE (Redis é recomendado em produção)
# ============================================
# Para desenvolvimento use LocMemCache
# CACHES_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Para produção use Redis:
# CACHES_BACKEND=django_redis.cache.RedisCache
# REDIS_URL=redis://127.0.0.1:6379/0
