# ============================================
# VARIÁVEIS DE AMBIENTE - SISTEMA DE VENDAS
# ============================================
# 
# INSTRUÇÕES: 
# 1. Copie este arquivo para .env
# 2. Preencha com seus valores reais
# 3. NUNCA commite .env para o repositório
# 4. Adicione .env ao .gitignore

# ============================================
# SEGURANÇA DJANGO
# ============================================

# SECRET_KEY: Gere uma nova chave com:
# python manage.py shell
# from django.core.management.utils import get_random_secret_key
# print(get_random_secret_key())
SECRET_KEY=sua-chave-secreta-aleatoria-super-longa-aqui

# DEBUG: True apenas em desenvolvimento
DEBUG=False

# Hosts permitidos (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,seu-dominio.com,www.seu-dominio.com

# ============================================
# BANCO DE DADOS
# ============================================

DB_ENGINE=django.db.backends.mysql
DB_NAME=seu_banco_dados
DB_USER=seu_usuario_bd
DB_PASSWORD=sua_senha_super_segura_bd
DB_HOST=seu-host-bd.com
DB_PORT=3306

# ============================================
# HTTPS E SEGURANÇA (Produção)
# ============================================

# Forçar HTTPS em produção
SECURE_SSL_REDIRECT=True

# Cookies seguros apenas em HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ============================================
# EMAIL (Opcional - para recuperação de senha)
# ============================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app-gmail

# ============================================
# OUTROS
# ============================================

# Timezone (padrão: America/Sao_Paulo)
TIME_ZONE=America/Sao_Paulo

# Ambiente (development, staging, production)
ENVIRONMENT=production
